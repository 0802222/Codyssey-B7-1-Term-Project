# 사용법: cp .env.example .env 후 값을 채운다. .env 는 Git 에 올라가지 않는다.
# 실제 키 값을 이 파일·이슈·PR·단톡에 쓰지 않는다.

# development | test | production
APP_ENV=development
DATABASE_URL=sqlite:///./data/easyexplain.db
SITE_ORIGIN=http://localhost:8000
LOG_LEVEL=INFO

# fake: 키 없이 개발·테스트 / anthropic: 코디세이 게이트웨이로 실제 호출
AI_PROVIDER=fake
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
CONTEXT_TURNS=5
CONTEXT_MAX_CHARS=12000

SESSION_TTL_SECONDS=7200
# 운영(HTTPS) 에서는 true
COOKIE_SECURE=false

USER_REQUESTS_PER_MINUTE=10
DAILY_REQUEST_LIMIT=200
